{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "^/(.*)", "dest": "/web/$1" }
  ]
}
