# PRISM AI Environment Configuration
PRISM_PORT=8765
PRISM_DATA=data

# Local / Ollama / OpenAI-compatible endpoint
PRISM_API_BASE=http://localhost:11434/v1
PRISM_API_KEY=

# Model IDs
# Primary LLM for answer generation, conflict detection and refusal
PRISM_CHAT_MODEL=qwen2.5:latest
# Multimodal model for chart/table visual transcription
PRISM_VISION_MODEL=qwen2.5-vl:latest
# Local embedding model (all-MiniLM-L6-v2)
PRISM_EMBED_MODEL=all-minilm

# OCR settings: Tesseract or Windows WinRT OCR fallback
TESSERACT_CMD=tesseract
PRISM_OCR_LANG=eng
