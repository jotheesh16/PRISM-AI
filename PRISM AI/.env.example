# Copy to .env. The server reads it on startup.
PRISM_PORT=8765
# PRISM_DATA=/absolute/path/to/private/workspace-data
# OpenAI-compatible API base, including /v1 when required by the provider.
PRISM_API_BASE=https://api.openai.com/v1
PRISM_API_KEY=
# Use model IDs available from your provider.
PRISM_CHAT_MODEL=
PRISM_VISION_MODEL=
PRISM_EMBED_MODEL=
# Optional Tesseract settings. Windows OCR is used when Tesseract is absent.
TESSERACT_CMD=tesseract
PRISM_OCR_LANG=eng
