# ==============================================================================
# PRISM AI — Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment
# ==============================================================================

# Server network binding
PORT=8765
PRISM_PORT=8765
PRISM_HOST=0.0.0.0

# Persistent storage directory (SQLite database, extracted vectors, uploaded PDFs)
PRISM_DATA=data

# ==============================================================================
# AI Model Endpoints (OpenAI-Compatible)
# ==============================================================================
# Local Ollama:
#   PRISM_API_BASE=http://localhost:11434/v1 (or http://host.docker.internal:11434/v1 inside Docker)
# Remote Cloud GPU / vLLM / RunPod / Modal:
#   PRISM_API_BASE=https://your-gpu-instance.example.com/v1
#   PRISM_API_KEY=your_secure_api_key_if_required
# OpenAI / Fast Hosted Fallback:
#   PRISM_API_BASE=https://api.openai.com/v1
#   PRISM_API_KEY=sk-...
PRISM_API_BASE=http://localhost:11434/v1
PRISM_API_KEY=

# 1. Main Answer Generation & Reasoning Model (Qwen3 4B Instruct)
PRISM_CHAT_MODEL=qwen3:4b

# 2. Multimodal Vision Model (Qwen2.5-VL 3B Instruct)
PRISM_VISION_MODEL=qwen2.5vl:3b

# 3. Dense Embedding Model (all-MiniLM-L6-v2)
PRISM_EMBED_MODEL=all-minilm

# ==============================================================================
# OCR Engine Settings
# ==============================================================================
# Tesseract 5 binary executable path ("tesseract" in Linux/Docker or full Windows path)
TESSERACT_CMD=tesseract
PRISM_OCR_LANG=eng

# ==============================================================================
# Vercel Deployment Settings (for Vercel Edge / Functions)
# ==============================================================================
# When deploying the frontend on Vercel, set this in your Vercel Project Settings:
# PRISM_BACKEND_URL=https://your-prism-backend-container.run.app

# ==============================================================================
# Supabase Cloud Database & Storage
# ==============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key
